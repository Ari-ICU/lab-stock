// ========================================================
// CSD LabStock Management System - Database ERD
// Engineered for PostgreSQL 16
// ========================================================

Project lab_stock {
  database_type: 'PostgreSQL'
  Note: '''
    # CSD LabStock Management System
    University & Faculty Laboratory Asset, Inventory & Equipment Custody Database
  '''
}

// --------------------------------------------------------
// 1. USERS & ACCESS CONTROL
// --------------------------------------------------------
Table users {
  id uuid [pk, default: `uuid_generate_v4()`, note: 'Primary Key']
  name varchar(150) [not null]
  email varchar(150) [unique, not null]
  password_hash varchar(255) [not null]
  role varchar(80) [not null, default: 'Faculty Lecturer', note: 'Admin, Lecturer, Technician']
  is_admin boolean [not null, default: false]
  department varchar(150)
  assigned_labs text[] [default: `ARRAY['all']::TEXT[]`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  Note: 'Faculty supervisors, lab administrators, and technicians'
}

// --------------------------------------------------------
// 2. LABORATORY FACILITIES & ROOMS
// --------------------------------------------------------
Table locations {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(50) [unique, not null, note: 'e.g. LOC-102B, LOC-206']
  name varchar(150) [not null, note: 'e.g. Computer & Network Lab 102B']
  room varchar(50) [not null, note: 'e.g. Room 102B']
  building varchar(100) [not null, note: 'e.g. Engineering Block A']
  floor int [default: 1]
  room_type varchar(50) [default: 'COMPUTER_LAB']
  capacity int [default: 30]
  last_audited_at timestamptz
  audited_by varchar(150)
  created_at timestamptz [default: `now()`]

  Note: 'Connected classrooms, research testbeds, and storage hubs'
}

// --------------------------------------------------------
// 3. HARDWARE EQUIPMENT ASSETS
// --------------------------------------------------------
Table assets {
  id uuid [pk, default: `uuid_generate_v4()`]
  serial_number varchar(100) [unique, not null, note: 'Hardware SN: OPT-102B-01, FCW2348L09M']
  name varchar(200) [not null, note: 'e.g. Cisco Catalyst 9300 48-Port Switch']
  model varchar(150) [not null, note: 'e.g. C9300-48P-A']
  total_units int [default: 1]
  unit_type varchar(50) [default: 'Units']
  location_id uuid [ref: > locations.id, note: 'Physical room where equipment is stationed']
  placement_rack varchar(100) [note: 'Wall Cabinet CAB-102B, Student Benches']
  status varchar(50) [not null, default: 'operational', note: 'operational, in_use, maintenance']
  loan_status varchar(50) [not null, default: 'available', note: 'available, on_loan']
  current_borrower varchar(150)
  loan_due_date date
  next_calibration varchar(80) [note: 'Audit / Inspection warranty timestamp']
  image_url text
  description text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    serial_number [name: 'idx_assets_serial']
    location_id [name: 'idx_assets_location']
  }

  Note: 'High-value persistent equipment (PCs, routers, switches, projectors)'
}

// --------------------------------------------------------
// 4. INVENTORY CONSUMABLES & PERIPHERALS
// --------------------------------------------------------
Table stock_items {
  id uuid [pk, default: `uuid_generate_v4()`]
  code varchar(80) [unique, not null, note: 'SKU: MON-102B-P2419H, KB-102B-KB216']
  name varchar(200) [not null]
  category varchar(100) [not null, note: 'Monitors, Mice & Keyboards, Networking, Stationery']
  quantity int [not null, default: 0]
  unit varchar(50) [not null, default: 'Units']
  location_id uuid [ref: > locations.id, note: 'Lab room where stock is stored']
  rack varchar(100) [note: 'Shelf SHF-01, Bench']
  status varchar(30) [not null, default: 'in_stock', note: 'in_stock, low_stock, out_of_stock']
  min_threshold int [default: 10]
  expiry_date varchar(80)
  image_url text
  description text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    category [name: 'idx_stock_items_category']
    status [name: 'idx_stock_items_status']
    location_id [name: 'idx_stock_items_location']
  }

  Note: 'Fast-moving consumables, peripherals, and spare components'
}

// --------------------------------------------------------
// 5. EQUIPMENT LOANS & CHECK-OUTS
// --------------------------------------------------------
Table loans {
  id uuid [pk, default: `uuid_generate_v4()`]
  asset_id uuid [not null, ref: > assets.id, note: 'Borrowed physical asset']
  borrower_name varchar(150) [not null, note: 'e.g. Sokha Chan']
  borrower_role varchar(80) [not null, default: 'Student', note: 'Student, Lecturer, Technician']
  borrower_contact varchar(100) [note: 'Email, Phone or Student ID']
  course_or_class varchar(150) [note: 'e.g. Advanced Network Capstone']
  borrow_date date [not null, default: `CURRENT_DATE`]
  expected_return_date date [not null]
  actual_return_date date [note: 'Null while active, filled on return']
  status varchar(30) [not null, default: 'active', note: 'active, returned, overdue']
  notes text [note: 'Condition checklist & supervisor inspection logs']
  created_at timestamptz [default: `now()`]

  indexes {
    status [name: 'idx_loans_status']
    asset_id [name: 'idx_loans_asset']
  }

  Note: 'Concurrency-safe student lending records with return inspection trails'
}

// --------------------------------------------------------
// 6. ROOM MOVEMENTS & PHYSICAL RELOCATIONS
// --------------------------------------------------------
Table transfers {
  id uuid [pk, default: `uuid_generate_v4()`]
  asset_id uuid [not null, ref: > assets.id, note: 'Relocated device']
  from_location_id uuid [ref: > locations.id, note: 'Origin room']
  to_location_id uuid [ref: > locations.id, note: 'Destination room']
  transfer_date date [not null, default: `CURRENT_DATE`]
  transferred_by varchar(150) [not null, note: 'Authorized faculty member or technician']
  reason text [note: 'e.g. Workshop setup, permanent reallocation']
  created_at timestamptz [default: `now()`]

  indexes {
    asset_id [name: 'idx_transfers_asset']
  }

  Note: 'Physical equipment movement history between lab rooms'
}

// --------------------------------------------------------
// 7. MAINTENANCE & AUDIT LOGS
// --------------------------------------------------------
Table maintenance_records {
  id uuid [pk, default: `uuid_generate_v4()`]
  asset_id uuid [ref: > assets.id, note: 'Serviced equipment']
  asset_name varchar(200) [not null]
  serial_number varchar(100) [not null]
  type varchar(100) [not null]
  date date [not null, default: `CURRENT_DATE`]
  technician varchar(150) [not null]
  status varchar(50) [not null, default: 'Pending']
  notes text
  image_url text
  location text
  cost numeric(12, 2)
  quantity int [default: 1]
  unit varchar(50) [default: 'units']
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    status [name: 'idx_maintenance_status']
    asset_id [name: 'idx_maintenance_asset']
  }

  Note: 'Equipment maintenance, repairs, inspections, and firmware upgrade history'
}

// --------------------------------------------------------
// 8. PURCHASE REQUESTS & REQUISITIONS
// --------------------------------------------------------
Table purchase_requests {
  id varchar(50) [pk]
  title varchar(255) [not null]
  category varchar(100) [not null]
  target_room varchar(50) [not null]
  quantity int [not null, default: 1]
  unit varchar(50) [not null, default: 'Units']
  estimated_cost varchar(50)
  priority varchar(20) [not null, default: 'medium']
  status varchar(30) [not null, default: 'pending']
  reason text [not null]
  requested_by varchar(150) [not null]
  requester_role varchar(100) [not null]
  request_date date [not null, default: `CURRENT_DATE`]
  image_url text
  notes text
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    status [name: 'idx_purchase_requests_status']
  }

  Note: 'Department equipment requisition and procurement requests'
}

// --------------------------------------------------------
// 9. ROOM FACILITY & CONDITION INVENTORY
// --------------------------------------------------------
Table room_inventory {
  id uuid [pk, default: `uuid_generate_v4()`]
  room_id uuid [ref: > locations.id]
  stock_item_id uuid [ref: > stock_items.id]
  asset_id uuid [ref: > assets.id]
  name varchar(150) [not null]
  group_type varchar(50) [not null, note: 'FURNITURE, ELECTRICAL, IT_HARDWARE, SAFETY_MISC']
  brand_spec varchar(150)
  unit varchar(50) [default: 'pcs']
  qty_working int [default: 0]
  qty_broken int [default: 0]
  qty_maintenance int [default: 0]
  remarks text
  last_audited_at timestamptz [default: `now()`]
  created_at timestamptz [default: `now()`]
  updated_at timestamptz [default: `now()`]

  indexes {
    room_id [name: 'idx_room_inventory_room']
  }

  Note: 'Location-centric bulk furniture, light fixtures, and bench inventory'
}

// --------------------------------------------------------
// TABLE GROUPS FOR CLEAN PRESENTATION
// --------------------------------------------------------
TableGroup Facility_Infrastructure {
  locations
  room_inventory
}

TableGroup Hardware_Fleet {
  assets
  transfers
  maintenance_records
}

TableGroup Consumable_Inventory {
  stock_items
  purchase_requests
}

TableGroup Custody_Operations {
  loans
  users
}
