<mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- Title Banner -->
    <mxCell id="title" value="CSD LabStock: Consumables Inventory &amp; Stock Level Flowchart&#xa;Atomic Quantity Updates, Concurrency-Safe Decrements, and Threshold Alert Evaluation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;align=center;shadow=1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="180" y="20" width="840" height="60" as="geometry" />
    </mxCell>

    <!-- Step 1: Start -->
    <mxCell id="start" value="START&#xa;Stock Consumed or Restocked" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="110" width="200" height="50" as="geometry" />
    </mxCell>

    <!-- Step 2: Request Adjustment -->
    <mxCell id="request" value="PATCH /api/v1/stock/:id/adjust&#xa;Payload: { delta: -5 } or { delta: +20 }" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#3730a3;align=center;" vertex="1" parent="1">
      <mxGeometry x="460" y="190" width="280" height="60" as="geometry" />
    </mxCell>

    <!-- Step 3: Auth & Permission -->
    <mxCell id="auth_check" value="Check JWT &amp; Permission&#xa;requirePermission('stock:update')?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="485" y="280" width="230" height="80" as="geometry" />
    </mxCell>

    <mxCell id="auth_denied" value="403 Forbidden&#xa;Insufficient Permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;align=center;" vertex="1" parent="1">
      <mxGeometry x="780" y="290" width="180" height="60" as="geometry" />
    </mxCell>

    <!-- Step 4: Atomic SQL Update -->
    <mxCell id="sql_exec" value="Execute Atomic SQL in PostgreSQL:&#xa;UPDATE stock_items&#xa;SET quantity = quantity + $1,&#xa;    status = CASE ...&#xa;WHERE id = $2 AND (quantity + $1) &gt;= 0&#xa;RETURNING *" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e40af;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="440" y="390" width="320" height="90" as="geometry" />
    </mxCell>

    <!-- Step 5: Check Rows Affected -->
    <mxCell id="row_check" value="Row Updated Successfully?&#xa;(Enough Stock Remaining?)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="495" y="515" width="210" height="85" as="geometry" />
    </mxCell>

    <mxCell id="insufficient_err" value="409 Conflict: Insufficient Stock&#xa;Cannot decrement below 0&#xa;(Prevents negative inventory counts)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;align=center;" vertex="1" parent="1">
      <mxGeometry x="780" y="527.5" width="220" height="60" as="geometry" />
    </mxCell>

    <!-- Step 6: Threshold Evaluation -->
    <mxCell id="threshold_eval" value="Evaluate Stock Status:&#xa;quantity &lt;= 0 ? &#39;out_of_stock&#39;&#xa;quantity &lt;= min_threshold ? &#39;low_stock&#39;&#xa;else &#39;in_stock&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;align=center;" vertex="1" parent="1">
      <mxGeometry x="465" y="635" width="270" height="75" as="geometry" />
    </mxCell>

    <!-- Step 7: Low Stock Warning? -->
    <mxCell id="warn_check" value="Status is &#39;low_stock&#39; or&#xa;&#39;out_of_stock&#39;?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="495" y="740" width="210" height="85" as="geometry" />
    </mxCell>

    <mxCell id="trigger_alert" value="Trigger Low-Stock Alert Banner&#xa;Flags SKU in Faculty Dashboard&#xa;for Lab Reorder Purchasing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;align=center;" vertex="1" parent="1">
      <mxGeometry x="780" y="752.5" width="210" height="60" as="geometry" />
    </mxCell>

    <!-- Step 8: Cache Eviction -->
    <mxCell id="cache_clear" value="Invalidate Stock Cache&#xa;cache.invalidatePattern(&#39;stock:&#39;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;fontColor=#6b21a8;align=center;" vertex="1" parent="1">
      <mxGeometry x="480" y="860" width="240" height="55" as="geometry" />
    </mxCell>

    <!-- Step 9: Client Response -->
    <mxCell id="client_resp" value="Return 200 OK + Updated Item&#xa;Client UI Updates Count &amp; Status Badge" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#3730a3;align=center;" vertex="1" parent="1">
      <mxGeometry x="460" y="945" width="280" height="60" as="geometry" />
    </mxCell>

    <!-- Step 10: Complete -->
    <mxCell id="end_done" value="SUCCESS&#xa;Inventory Adjusted Accurately" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="1035" width="200" height="50" as="geometry" />
    </mxCell>

    <!-- Connectors -->
    <mxCell id="e1" edge="1" source="start" target="request" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e2" edge="1" source="request" target="auth_check" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e3" edge="1" source="auth_check" target="auth_denied" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e3_l" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#b91c1c;fontStyle=1;" vertex="1" connectable="0" parent="e3">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e4" edge="1" source="auth_check" target="sql_exec" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e4_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#047857;fontStyle=1;" vertex="1" connectable="0" parent="e4">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e5" edge="1" source="sql_exec" target="row_check" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e6" edge="1" source="row_check" target="insufficient_err" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e6_l" value="No (Stock &lt; delta)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#b91c1c;fontStyle=1;" vertex="1" connectable="0" parent="e6">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e7" edge="1" source="row_check" target="threshold_eval" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e7_l" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#047857;fontStyle=1;" vertex="1" connectable="0" parent="e7">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e8" edge="1" source="threshold_eval" target="warn_check" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e9" edge="1" source="warn_check" target="trigger_alert" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e9_l" value="Yes (Low / Out)" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#d97706;fontStyle=1;" vertex="1" connectable="0" parent="e9">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e10" edge="1" source="warn_check" target="cache_clear" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e10_l" value="Normal" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#047857;fontStyle=1;" vertex="1" connectable="0" parent="e10">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e11" edge="1" source="trigger_alert" target="cache_clear" parent="1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="885" y="888" />
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="e12" edge="1" source="cache_clear" target="client_resp" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e13" edge="1" source="client_resp" target="end_done" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>

