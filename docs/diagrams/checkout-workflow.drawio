<mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1600" math="0" shadow="0">
  <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />

    <!-- Title Banner -->
    <mxCell id="title" value="CSD LabStock: Concurrency-Safe Equipment Check-Out &amp; Lending Workflow&#xa;Automated Barcode Lookup, RBAC Security, PostgreSQL ACID Row-Locking, and Cache Eviction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#0f172a;align=center;shadow=1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
      <mxGeometry x="180" y="20" width="840" height="60" as="geometry" />
    </mxCell>

    <!-- Step 1: Start -->
    <mxCell id="start" value="START&#xa;Student / Faculty Requests Equipment" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="110" width="200" height="50" as="geometry" />
    </mxCell>

    <!-- Step 2: Barcode / Search -->
    <mxCell id="scan" value="Identify Hardware&#xa;Scan Barcode / QR with Camera&#xa;or Search Serial / SKU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;align=center;" vertex="1" parent="1">
      <mxGeometry x="490" y="190" width="220" height="60" as="geometry" />
    </mxCell>

    <!-- Step 3: Decision: Is available? -->
    <mxCell id="decide_avail" value="Is Equipment&#xa;Available in Lab?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="505" y="280" width="190" height="80" as="geometry" />
    </mxCell>

    <!-- Path: Not available -->
    <mxCell id="already_loaned" value="Alert: Already On Loan&#xa;Display Active Borrower Profile&#xa;and Scheduled Return Date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;align=center;" vertex="1" parent="1">
      <mxGeometry x="780" y="290" width="200" height="60" as="geometry" />
    </mxCell>

    <mxCell id="end_rejected" value="END&#xa;Check-Out Denied" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ef4444;strokeColor=#dc2626;fontColor=#ffffff;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1030" y="295" width="130" height="50" as="geometry" />
    </mxCell>

    <!-- Step 4: Fill Check-out Details -->
    <mxCell id="fill_form" value="Fill Check-Out Form&#xa;Borrower Name, Role (Student/Lecturer),&#xa;Contact ID, Course/Class, Due Date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;align=center;" vertex="1" parent="1">
      <mxGeometry x="480" y="390" width="240" height="65" as="geometry" />
    </mxCell>

    <!-- Step 5: Submit API Request -->
    <mxCell id="submit_api" value="Client Dispatches Request&#xa;POST /api/v1/loans/checkout&#xa;Payload: { assetId, borrowerName, returnDate }" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#3730a3;align=center;" vertex="1" parent="1">
      <mxGeometry x="460" y="485" width="280" height="60" as="geometry" />
    </mxCell>

    <!-- Step 6: Auth & Permission Guard -->
    <mxCell id="decide_auth" value="Valid JWT Token &amp;&#xa;loan:checkout Permission?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="485" y="575" width="230" height="80" as="geometry" />
    </mxCell>

    <mxCell id="auth_error" value="401 / 403 Error&#xa;Unauthorized / Invalid Token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;align=center;" vertex="1" parent="1">
      <mxGeometry x="780" y="585" width="180" height="60" as="geometry" />
    </mxCell>

    <!-- Step 7: Database Transaction & Locking -->
    <mxCell id="db_tx" value="PostgreSQL ACID Transaction BEGIN&#xa;SELECT * FROM assets WHERE id = $1 FOR UPDATE&#xa;(Acquires Pessimistic Row-Level Lock)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e40af;align=center;" vertex="1" parent="1">
      <mxGeometry x="450" y="685" width="300" height="65" as="geometry" />
    </mxCell>

    <!-- Step 8: Concurrency Double-Booking Check -->
    <mxCell id="decide_race" value="Asset Row Still&#xa;Available in DB?&#xa;(Race Condition Guard)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#92400e;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="495" y="780" width="210" height="85" as="geometry" />
    </mxCell>

    <mxCell id="conflict_abort" value="409 Conflict: Double-Booking Blocked&#xa;ROLLBACK Transaction&#xa;Another user checked out this item first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#991b1b;align=center;" vertex="1" parent="1">
      <mxGeometry x="780" y="792.5" width="220" height="60" as="geometry" />
    </mxCell>

    <!-- Step 9: Atomic Updates & Commit -->
    <mxCell id="db_commit" value="Atomic DB State Transition&#xa;1. INSERT INTO loans (...) VALUES (...)&#xa;2. UPDATE assets SET loan_status = &#39;on_loan&#39;&#xa;3. PostgreSQL COMMIT (Lock Released)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;fontColor=#065f46;align=center;" vertex="1" parent="1">
      <mxGeometry x="460" y="895" width="280" height="70" as="geometry" />
    </mxCell>

    <!-- Step 10: Cache Eviction -->
    <mxCell id="cache_evict" value="Instant Cache Eviction&#xa;cache.invalidatePattern(&#39;loan:&#39;)&#xa;cache.invalidatePattern(&#39;asset:&#39;)&#xa;Guarantees zero stale reads for other users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#a855f7;fontColor=#6b21a8;align=center;" vertex="1" parent="1">
      <mxGeometry x="465" y="995" width="270" height="65" as="geometry" />
    </mxCell>

    <!-- Step 11: Real-time Client Update -->
    <mxCell id="client_update" value="Client UI Real-Time Update&#xa;201 Created Response Received&#xa;Toast: &#39;Equipment checked out successfully&#39;&#xa;Auto-redirect to dedicated /loans/[id] dossier" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#3730a3;align=center;" vertex="1" parent="1">
      <mxGeometry x="450" y="1090" width="300" height="65" as="geometry" />
    </mxCell>

    <!-- Step 12: Success End -->
    <mxCell id="end_success" value="SUCCESS&#xa;Equipment Issued &amp; In Custody" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#10b981;strokeColor=#059669;fontColor=#ffffff;align=center;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="1185" width="200" height="50" as="geometry" />
    </mxCell>

    <!-- Connectors -->
    <mxCell id="e1" edge="1" source="start" target="scan" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e2" edge="1" source="scan" target="decide_avail" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e3" edge="1" source="decide_avail" target="already_loaned" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e3_label" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#b91c1c;fontStyle=1;" vertex="1" connectable="0" parent="e3">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e4" edge="1" source="already_loaned" target="end_rejected" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e5" edge="1" source="decide_avail" target="fill_form" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e5_label" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#047857;fontStyle=1;" vertex="1" connectable="0" parent="e5">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e6" edge="1" source="fill_form" target="submit_api" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e7" edge="1" source="submit_api" target="decide_auth" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e8" edge="1" source="decide_auth" target="auth_error" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e8_label" value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#b91c1c;fontStyle=1;" vertex="1" connectable="0" parent="e8">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e9" edge="1" source="decide_auth" target="db_tx" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e9_label" value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#047857;fontStyle=1;" vertex="1" connectable="0" parent="e9">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e10" edge="1" source="db_tx" target="decide_race" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e11" edge="1" source="decide_race" target="conflict_abort" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e11_label" value="Conflict" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#b91c1c;fontStyle=1;" vertex="1" connectable="0" parent="e11">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e12" edge="1" source="decide_race" target="db_commit" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>
    <mxCell id="e12_label" value="Verified" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#047857;fontStyle=1;" vertex="1" connectable="0" parent="e12">
      <mxGeometry x="-0.2" relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e13" edge="1" source="db_commit" target="cache_evict" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e14" edge="1" source="cache_evict" target="client_update" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

    <mxCell id="e15" edge="1" source="client_update" target="end_success" parent="1">
      <mxGeometry relative="1" as="geometry" />
    </mxCell>

  </root>
</mxGraphModel>
